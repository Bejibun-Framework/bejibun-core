{
    "name": "@bejibun/core",
    "version": "0.6.16",
    "author": "Havea Crenata <havea.crenata@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bejibun-Framework/bejibun-core.git"
    },
    "main": "index.js",
    "module": "index.js",
    "devDependencies": {
        "@bejibun/x402": "^0.2.13",
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.4.2",
        "@types/reflect-metadata": "^0.1.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "tsc-alias": "^1.9.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0"
    },
    "bugs": {
        "url": "https://github.com/Bejibun-Framework/bejibun-core/issues"
    },
    "description": "Core of Bejibun Framework",
    "homepage": "https://github.com/Bejibun-Framework/bejibun-core#readme",
    "keywords": [
        "bun",
        "bun framework",
        "core",
        "bejibun",
        "typescript"
    ],
    "license": "MIT",
    "scripts": {
        "alias": "tsc-alias -p tsconfig.json",
        "stubs": "cp -rf src/stubs dist",
        "stubs-clean": "rm -rf stubs",
        "types": "cp -rf src/types dist",
        "rsync": "rsync -a dist/ ./",
        "clean": "rm -rf dist",
        "format": "prettier --write src --log-level=silent",
        "eslint": "eslint src",
        "lint": "bun run format && bun run eslint",
        "build": "bun run clean && bun run stubs-clean && bun run lint && tsc -p tsconfig.json && bun run types && bun run alias && bun run stubs && bun run rsync && bun run clean",
        "deploy": "bun run build && bun publish --access public"
    },
    "type": "module",
    "types": "index.d.ts",
    "dependencies": {
        "@bejibun/app": "^0.1.27",
        "@bejibun/cache": "^0.1.27",
        "@bejibun/cors": "^0.1.20",
        "@bejibun/database": "^0.1.24",
        "@bejibun/limiter": "^0.1.13",
        "@bejibun/logger": "^0.2.10",
        "@bejibun/storage": "^0.1.12",
        "@bejibun/utils": "^0.1.31",
        "@vinejs/vine": "^4.4.0",
        "commander": "^15.0.0",
        "cron-parser": "^5.10.0",
        "luxon": "^3.7.2",
        "objection": "^3.1.5",
        "reflect-metadata": "^0.2.2"
    }
}
